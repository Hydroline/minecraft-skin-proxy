# A dedicated DNS name pointing to this VPS. Caddy will obtain its TLS certificate.
NMSR_PUBLIC_HOST=skins-origin.example.com

# Generate a long random value. This same value must be set as the Worker's
# NMSR_ORIGIN_TOKEN secret; it prevents public use of the origin service.
NMSR_ORIGIN_TOKEN=replace-with-a-long-random-secret
